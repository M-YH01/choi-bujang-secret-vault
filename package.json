{
  "name": "aleph-defense-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-public.mjs",
    "test:r5": "node --test test/r5.test.mjs",
    "test:package": "node --test test/package-starter.test.mjs",
    "test:notes": "node --test test/notes-api.test.mjs",
    "test:decider": "node --test test/decider.test.mjs",
    "test:detect": "node --test test/detect.test.mjs",
    "test:restore": "node --test test/restore-api.test.mjs",
    "test:device": "node --test test/device.test.mjs",
    "test:ops": "node --test test/ops.test.mjs",
    "verify:matrix": "node scripts/verify-matrix.mjs",
    "bundle": "node scripts/bundle.mjs",
    "decider:test": "node scripts/decider-test.mjs",
    "detect:test": "node scripts/detect-test.mjs",
    "fixture:7": "node scripts/fixture-7.mjs",
    "xdr:run": "node scripts/xdr-run.mjs",
    "test:policy": "node --test test/policy.test.mjs",
    "policy:snapshot": "node scripts/policy.mjs snapshot",
    "policy:diff": "node scripts/policy.mjs diff",
    "policy:restore": "node scripts/policy.mjs restore",
    "check:all": "node --test test/*.test.mjs && node scripts/decider-test.mjs && node scripts/detect-test.mjs && node scripts/build-public.mjs --local"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jose": "6.2.12"
  }
}
